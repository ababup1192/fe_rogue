#!/usr/bin/env bash
# flix ラッパ。CWD が ide/ 配下のときは AWT/Swing 用に -XstartOnFirstThread を付けない。
# それ以外 (engine, editor, examples の GLFW ベース) では macOS の AppKit 要件のため付ける。
#
# IDE モードかつ `run` サブコマンドのときに限り、起動前に
# `make -C <project_root> clean-example-builds` を呼ぶ。
# ProjectLoader.findSceneFiles の Fs.Glob が examples/*/build/class 配下の
# 数十万 .class ファイルを stat して数分かかる問題を回避するため。
# (clean したぶん examples の incremental compile キャッシュは失われる)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
case "$PWD" in
    */ide|*/ide/*)
        if [ "$1" = "run" ]; then
            make -C "$PROJECT_ROOT" clean-example-builds >&2
        fi
        exec java -jar "$SCRIPT_DIR/flix.jar" "$@"
        ;;
    *)
        # test と bake (run --entrypoint Bake.*) はヘッドレス処理 (実ウィンドウを開かない) なので
        # java.awt.headless=true を明示する。-XstartOnFirstThread 下でワーカースレッドが
        # AWT を初期化 (HeadlessFont → BufferedImage) すると AppKit 待ちで永久ハングし得るため。
        # ゲーム実機起動 (通常の run) には付けない。
        HEADLESS=""
        case "$1 $*" in
            test\ *|test) HEADLESS="-Djava.awt.headless=true" ;;
            *"--entrypoint Bake"*) HEADLESS="-Djava.awt.headless=true" ;;
        esac
        exec java -XstartOnFirstThread $HEADLESS -jar "$SCRIPT_DIR/flix.jar" "$@"
        ;;
esac
