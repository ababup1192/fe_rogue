{
  "note": "check-refs（文章や Makefile が指す先が実在するか）の規約データ。source of truth は bin/check-refs.py で、この JSON はそこに書いてある値を一字一句そのまま写した物。Go 版（bin/fge-go check-refs）はこれを読んで動くので、規約を変えるときは bin/check-refs.py とこの 2 つを同時に直す。ずれると go/internal/checkrefs の TestRulesMatchPython が落ちる。",
  "bundleRequired": [
    "Makefile",
    "flix.toml",
    "bin/flix",
    "bin/checkd",
    "bin/explain-error",
    "bin/gen-api-digest.py",
    "bin/reference-update.sh",
    "bin/reference-check.sh",
    "bin/check-render-budget.py",
    "mk/game.mk",
    "bin/fge",
    "bin/img-digest.py",
    "bin/status.py",
    "bin/lint-view.py",
    "bin/lint-palette.py",
    "bin/lint-sprite.py",
    "bin/lint-anim.py",
    "bin/lint-audio.py",
    "bin/lint-images.py",
    "bin/lint-ui-overflow.py",
    "bin/precommit.py",
    "bin/githooks/pre-commit",
    "bin/sync-agents.py",
    "bin/carve/carve.py",
    "docs/api-digest.md",
    "docs/api-digest/engine.md",
    "docs/api-digest/engine_world.md",
    "docs/api-digest/engine_tools.md",
    "docs/module-index.md",
    "docs/engine-module-index.md",
    "docs/doc-conventions.md",
    "docs/glossary.md",
    "docs/shader-doc.md",
    "docs/checkd.md",
    ".claude/hooks/after-flix-edit.py",
    ".claude/hooks/session-diet.py",
    "agents-pack/AGENTS.core.md",
    "agents-pack/settings.json",
    "agents-pack/manifest.json",
    "agents-pack/codex-hooks.json",
    "agents-pack/rules/drawing.md",
    "agents-pack/rules/flix.md",
    "templates/game-starter/Makefile",
    "engine_full/flix.toml",
    "engine_full/artifact/engine_full.fpkg"
  ],
  "bundleSkipOnWindows": ["bin/flix", "bin/reference-update.sh", "bin/reference-check.sh"],
  "bundleWindowsExtra": ["bin/flix.jar"],
  "templateRequired": ["Makefile", "flix.toml", "project.json", "reference/title.png"],
  "skipMarks": ["$(", "__", "...", "<", ">"],
  "trimChars": ".,;:)'\"`",
  "manifestKeys": ["copy", "copyIfAbsent", "copyDirs"],
  "templateGlobs": ["templates/*/Makefile", "mk/*.mk"],
  "enginePathSkip": ["bin/flix.jar"],
  "distExempt": ["bin/flix", "bin/flix.jar"],
  "pathPattern": "(?<![\\w$.:/-])(bin|docs)/[A-Za-z0-9_*/.-]+",
  "enginePathPattern": "\\$\\(ENGINE\\)/((?:bin|docs)/[A-Za-z0-9_*/.-]+)",
  "rulePattern": "\\.claude/rules/([A-Za-z0-9_-]+\\.md)",
  "hookPattern": "\\.claude/hooks/([A-Za-z0-9_.-]+\\.py)",
  "genesisStarterPattern": "starter\\s*=\\s*\"([^\"]*)\"",
  "commentPattern": "(^|\\s)@?#.*$",
  "lastSegmentPattern": "/[^/]+$",
  "echoPattern": "\\b(echo|printf)\\s+(\"[^\"]*\"|'[^']*')"
}
