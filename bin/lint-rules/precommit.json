{
  "note": "precommit（git commit の直前に走るゲート）の規約データ。source of truth は bin/precommit.py と bin/lint-images.py で、この JSON はそこに書いてある値と並びを一字一句そのまま写した物。Go 版（bin/fge-go precommit）はこれを読んで動くので、規約を変えるときは Python 側とこの JSON を同時に直す。ずれると go/internal/precommit の TestRulesMatchPython が落ちる。checks の並びはそのまま出力の並びになるので配列で持つ。",
  "stagedImages": {
    "tool": "lint-images.py",
    "sub": "images",
    "imageExts": [".png", ".gif", ".jpg", ".jpeg", ".webp", ".bmp"],
    "galleryPrefix": "docs/gallery/",
    "galleryMaxFileBytes": 307200,
    "allowedPrefixes": ["docs/gallery/", "docs/brand/"],
    "allowedSubstrings": ["/assets/"],
    "allowedSuffixes": ["/reference/title.png"],
    "allowedExact": ["reference/title.png"]
  },
  "checks": [
    {
      "id": "view",
      "tool": "lint-view.py",
      "sub": "view",
      "flags": [],
      "pass": "matched",
      "when": {"suffixes": [".flix"]}
    },
    {
      "id": "palette",
      "tool": "lint-palette.py",
      "sub": "palette",
      "flags": [],
      "pass": "none",
      "when": {"anyOf": [
        {"suffixes": [".sprite.json", ".theme.json"]},
        {"substrings": ["palette"]}
      ]}
    },
    {
      "id": "ui-overflow",
      "tool": "lint-ui-overflow.py",
      "sub": "ui-overflow",
      "flags": ["--strict"],
      "pass": "matched",
      "when": {"suffixes": [".ui.json"]}
    },
    {
      "id": "fallback",
      "tool": "lint-fallback.py",
      "sub": "fallback",
      "flags": [],
      "pass": "none",
      "when": {"suffixes": [".flix"]}
    },
    {
      "id": "f32",
      "tool": "lint-f32.py",
      "sub": "f32",
      "flags": [],
      "pass": "none",
      "when": {
        "suffixes": [".flix"],
        "prefixes": ["engine/src/", "engine_world/src/", "engine_tools/src/"]
      }
    },
    {
      "id": "jargon",
      "tool": "lint-jargon.py",
      "sub": "jargon",
      "flags": [],
      "pass": "none",
      "when": {"anyOf": [
        {"suffixes": [".md", ".flix", ".elm", ".json", ".py"]},
        {"basenames": ["Makefile"]}
      ]}
    }
  ],
  "docsSync": {
    "target": "check-docs-sync",
    "when": {"anyOf": [
      {"basenames": ["Makefile"]},
      {"prefixes": [
        ".claude/", "agents-pack/", "templates/",
        "bin/gen-rules.py", "bin/gen-api-digest.py", "bin/check-api-index.py",
        "bin/check-refs.py"
      ]},
      {"suffixes": [".md", ".flix"]}
    ]}
  },
  "failOpen": {
    "toolMissing": "[pre-commit] bin/{name} が無いのでその検査は飛ばします (engine の make sync-agents GAME=... で配り直せます)",
    "makeMissing": "[pre-commit] make が見つからないので配線検査 (check-docs-sync) は飛ばします",
    "targetMissing": "[pre-commit] make check-docs-sync が無いので配線検査は飛ばします",
    "targetMissingExitCode": 2
  }
}
