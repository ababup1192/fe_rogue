#!/bin/sh
# 中身は bin/precommit.py に 1 本化してある (Windows の Git Bash でも動くよう薄い入口だけ)。
# 配線: make hooks (git config core.hooksPath bin/githooks)
# python3 が無い環境 (素の Windows 等) では関所の都合でコミットを壊さない (fail-open)
command -v python3 >/dev/null 2>&1 || { echo "[pre-commit] python3 が見つからないので関所は素通りします"; exit 0; }
exec python3 "$(git rev-parse --show-toplevel)/bin/precommit.py"
