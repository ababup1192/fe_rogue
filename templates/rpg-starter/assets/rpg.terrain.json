{
  "version": 1,
  "note": "セル文字→地面の質感の表。色は @キー で持ち、実色は ThemeDoc.resolver が決める。読むのは描き出しの terrain_grain だけで、遊ぶ画面（World と View）はこの表を通らない。",
  "styleMix": { "round": 0.55, "square": 0.25 },
  "entries": [
    {
      "char": "#",
      "name": "石垣",
      "fill": "@wall",
      "edge": { "top": "@wallTop", "side": "@wallSide", "shade": "@wallShade" },
      "edgeWidth": 2.5,
      "style": "mix",
      "jitter": 0.35,
      "mottle": 0.05,
      "height": { "lift": 7.0, "front": "@wallFront", "shade": "@wallShade", "clipToFloor": true }
    },
    {
      "char": ".",
      "name": "土の道",
      "fill": "@woodMid",
      "edge": { "uniform": "@woodDark" },
      "edgeWidth": 1.5,
      "style": "round",
      "jitter": 0.0,
      "surface": [ { "preset": "grain", "color": "@woodLight" } ],
      "mottle": 0.035
    },
    {
      "char": "~",
      "name": "水路",
      "fill": "@water",
      "edge": { "uniform": "@waterShade" },
      "edgeWidth": 1.5,
      "style": "round",
      "jitter": 0.0,
      "surface": [ { "preset": "sparkle", "color": "@waterGlint" } ],
      "mottle": 0.0
    },
    {
      "char": ",",
      "name": "畑",
      "fill": "@grassDark",
      "edge": { "uniform": "@fieldShade" },
      "edgeWidth": 1.5,
      "style": "round",
      "jitter": 0.0,
      "surface": [ { "preset": "grain", "color": "@grassBright" } ],
      "mottle": 0.09
    }
  ]
}
