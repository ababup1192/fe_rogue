{
  "//": "rpg.terrain.json の形の宣言（sections 方言）。色は '#rrggbb' か '@キー' の文字列なので type は text（color ピッカーは @参照を表せない）",
  "version": 1,
  "sections": {
    "styleMix": {
      "kind": "record",
      "fields": {
        "round":  { "type": "float", "label": "丸角の割合",   "order": 1, "min": 0, "max": 1, "default": 0.4 },
        "square": { "type": "float", "label": "四角の割合", "order": 2, "min": 0, "max": 1, "default": 0.4 }
      }
    },
    "entries": {
      "kind": "list",
      "label": "セル文字→質感",
      "item": {
        "kind": "record",
        "fields": {
          "char":      { "type": "text", "label": "rows の文字（1文字）", "order": 1, "required": true },
          "name":      { "type": "text", "label": "名前（パレットに出る）", "order": 2, "required": true },
          "fill":      { "type": "text", "label": "塗り（#rrggbb か @キー）", "order": 3, "required": true },
          "edge": {
            "type": { "record": {
              "uniform": { "type": "text", "label": "一様な縁（これがあれば先勝ち）", "order": 1 },
              "top":     { "type": "text", "label": "上の縁", "order": 2 },
              "side":    { "type": "text", "label": "横の縁", "order": 3 },
              "shade":   { "type": "text", "label": "陰の縁", "order": 4 }
            } },
            "label": "縁の色（uniform か top/side/shade。色は #rrggbb か @キー）", "order": 4
          },
          "edgeWidth": { "type": "float",  "label": "フチの太さ（px）", "order": 5, "min": 0, "max": 8, "default": 1.5 },
          "style":     { "type": { "enum": ["round", "square", "diamond", "mix"] }, "label": "角の形", "order": 6, "default": "mix" },
          "jitter":    { "type": "float",  "label": "岩肌の揺らぎ", "order": 7, "min": 0, "max": 2, "default": 0 },
          "surface": {
            "type": { "list": { "record": {
              "preset": { "type": { "enum": ["sparkle", "scales", "bubble", "glow"] }, "label": "粒の種類", "order": 1, "required": true },
              "color":  { "type": "text", "label": "粒の色（#rrggbb か @キー）", "order": 2, "required": true }
            } } },
            "label": "表面の粒（プリセット+1色）", "order": 8
          },
          "height": {
            "type": { "record": {
              "lift":        { "type": "float", "label": "持ち上げ（px）", "order": 1, "min": 0, "max": 12, "default": 6.0 },
              "front":       { "type": "text",  "label": "立ち面の色", "order": 2 },
              "shade":       { "type": "text",  "label": "落ち影の色", "order": 3 },
              "clipToFloor": { "type": "bool",  "label": "床で刈り取る", "order": 4, "default": true }
            } },
            "label": "持ち上げ（宣言しなければ平ら）", "order": 9
          }
        }
      }
    }
  }
}
