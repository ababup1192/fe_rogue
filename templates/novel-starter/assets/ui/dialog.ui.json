{
  "$schema": "ui.schema.json",
  "version": 1,
  "//": "会話窓。話者タグ + 本文置き場 + 進行ヒント。本文(文字送り)は NovelKit.body が RichText.place で描くので、ここは枠と話者だけ。",
  "defaultFont": "default",
  "paletteFile": "assets/ui/palette.json",

  "root": {
    "name": "novel_dialog", "visible": false,
    "children": [
      { "name": "panel", "widget": "box", "abs": [12, 226], "width": 456, "height": 62,
        "color": "@panel", "cornerRadius": 4, "borderWidth": 1, "borderColor": "@panelBorder",
        "zIndex": 100,
        "dir": "column", "pad": [10, 5, 10, 5],
        "children": [
          { "name": "speaker", "widget": "text", "text": "", "wrap": "auto", "fontSize": 9,
            "tint": "@accent", "zIndex": 102 },
          { "name": "hint", "widget": "text", "text": "クリック / Z", "fontSize": 7,
            "tint": "@hint", "zIndex": 102, "abs": [386, 46],
            "lint-ui": "対象外 — 操作案内の固定短文で、実行時に文言が変わらない" }
        ] }
    ]
  }
}
