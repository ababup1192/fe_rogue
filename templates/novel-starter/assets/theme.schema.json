{
  "//": "novel.theme.json の形の宣言（Studio の sections 方言）。色 1 つ = kind field / type color のセクション 1 つ。雨すじの加減も世界の空気なのでここに置く。派生色はコードで導く（独自の色を増やさない）。",
  "version": 1,
  "sections": {
    "bg":     { "kind": "field", "type": "color", "label": "部屋の闇（床・全体）", "order": 1, "required": true },
    "wall":   { "kind": "field", "type": "color", "label": "書斎の壁",             "order": 2, "required": true },
    "window": { "kind": "field", "type": "color", "label": "雨の窓",               "order": 3, "required": true },
    "accent": { "kind": "field", "type": "color", "label": "灯り・金（差し色）",   "order": 4, "required": true },
    "ink":    { "kind": "field", "type": "color", "label": "本文・表紙の文字色",   "order": 5, "required": true },
    "rainCount": {
      "kind": "field",
      "type": "int",
      "label": "窓の雨すじの本数",
      "order": 6,
      "min": 0,
      "max": 30,
      "default": 7
    },
    "rainGlow": {
      "kind": "field",
      "type": "float",
      "label": "雨すじの明るさ（窓の色をどれだけ白に寄せるか。0〜1）",
      "order": 7,
      "min": 0,
      "max": 1,
      "default": 0.22
    }
  }
}
