{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MIDNIGHT APEX pixel scenery",
  "description": "文字格子のドット絵。legendが文字を意味色へ結び、spritesが名前付きの絵を持つ。",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "note": { "type": "string" },
    "paletteFile": {
      "type": "string",
      "description": "legend の意味色キーを解決する色票（Studio のドット絵エディタが引く。ゲーム側は無視し、実色は CityscapeView.colorOf / SceneryView.patternColor が決める）"
    },
    "legend": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "propertyNames": { "minLength": 1, "maxLength": 1 }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "anchor": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "frames": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "required": ["frames"]
      }
    }
  },
  "required": ["version", "legend", "sprites"]
}
