{
  "//": "race.rivals.json の形の宣言（Studio の sections 方言）。ラバーバンド = 自機との距離差でライバルの速度を補正する仕組み（離されると速く・千切ると遅く — 常に接戦へ戻す）。rows 1 行 = ライバル 1 台。追いかける・避ける・コーナーで減速するの規則はコード（World）側。",
  "version": 1,
  "sections": {
    "note": {
      "kind": "field",
      "type": "text",
      "label": "メモ",
      "order": 0,
      "widget": "multiline",
      "group": "追いかけ方"
    },
    "rubberRange": {
      "kind": "field",
      "type": "float",
      "label": "補正が最大になる距離差（狭いほど過敏に効く）",
      "unit": "px",
      "order": 1,
      "min": 50,
      "max": 2000,
      "default": 220,
      "group": "追いかけ方"
    },
    "rubberCatchUp": {
      "kind": "field",
      "type": "float",
      "label": "離されたときの加速の上限（0.22 = +22%）",
      "order": 2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.45,
      "group": "追いかけ方"
    },
    "rubberSlowDown": {
      "kind": "field",
      "type": "float",
      "label": "先行したときの減速の上限（0.15 = -15%）",
      "order": 3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.22,
      "group": "追いかけ方"
    },
    "laneChangeSpeed": {
      "kind": "field",
      "type": "float",
      "label": "横へ寄る速さ（大きいほど機敏に避ける）",
      "unit": "px/秒",
      "order": 4,
      "min": 10,
      "max": 300,
      "default": 140,
      "group": "追いかけ方"
    },
    "cornerSlow": {
      "kind": "field",
      "type": "float",
      "label": "下手な敵が急カーブで落とす速度の底（小さいほど大きく減速）",
      "order": 5,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "default": 0.7,
      "group": "追いかけ方"
    },
    "rows": {
      "kind": "list",
      "label": "ライバル（1 行 = 1 台。行を増やすと台数が増える）",
      "fields": {
        "speed": {
          "type": "float",
          "label": "地力の速さ",
          "unit": "px/秒",
          "order": 1,
          "min": 20,
          "max": 400,
          "default": 110,
          "required": true
        },
        "corner": {
          "type": "float",
          "label": "コーナーの上手さ（1 = 減速なし・0 = 大きく減速）",
          "order": 2,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 0.6
        },
        "lane": {
          "type": "float",
          "label": "好みの走行位置（-1 = 左寄り・0 = 真ん中・+1 = 右寄り）",
          "order": 3,
          "min": -1,
          "max": 1,
          "step": 0.05,
          "default": 0
        }
      }
    }
  }
}
