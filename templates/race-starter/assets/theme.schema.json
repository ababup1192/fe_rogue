{
  "//": "race.theme.json の形の宣言（Studio の sections 方言）。真夏の海岸ハイウェイの色票。色 1 つ = kind field / type color。派生色（縞の明暗・霞み・炎の芯・火花）はコードで導く（独自の色を増やさない）。fx の @色もここから引かれるが、反映は fx の保存か F1（ロード時に焼き込まれるため）。",
  "version": 1,
  "sections": {
    "note":   { "kind": "field", "type": "text", "label": "メモ", "order": 0, "widget": "multiline", "group": "空と海" },
    "skyTop": { "kind": "field", "type": "color", "label": "空の上端（コバルト）", "order": 1, "required": true, "group": "空と海" },
    "skyLow": { "kind": "field", "type": "color", "label": "地平線ぎわの空（遠くの霞みもこの色へ寄る）", "order": 2, "required": true, "group": "空と海" },
    "sea":    { "kind": "field", "type": "color", "label": "海（きらめきはコードで明るく導く）", "order": 3, "required": true, "group": "空と海" },

    "grass":  { "kind": "field", "type": "color", "label": "草地（縞の暗い側はコードで導く）", "order": 10, "required": true, "group": "地面" },
    "road":   { "kind": "field", "type": "color", "label": "路面（縞の明るい側はコードで導く）", "order": 11, "required": true, "group": "地面" },
    "sand":   { "kind": "field", "type": "color", "label": "乾いた砂（路肩の筋・草の轍・海ぎわの浜）", "order": 12, "required": true, "group": "地面" },
    "lane":   { "kind": "field", "type": "color", "label": "中央の白線", "order": 13, "required": true, "group": "地面" },
    "kerb":   { "kind": "field", "type": "color", "label": "縁石の赤（白側は「ゴールの白」を使う）", "order": 14, "required": true, "group": "地面" },

    "player": { "kind": "field", "type": "color", "label": "自機の車体", "order": 20, "required": true, "group": "マシン" },
    "rivalA": { "kind": "field", "type": "color", "label": "ライバル A の車体", "order": 21, "required": true, "group": "マシン" },
    "rivalB": { "kind": "field", "type": "color", "label": "ライバル B の車体", "order": 22, "required": true, "group": "マシン" },
    "rivalC": { "kind": "field", "type": "color", "label": "ライバル C の車体", "order": 23, "required": true, "group": "マシン" },

    "flame":  { "kind": "field", "type": "color", "label": "ニトロの炎（芯の白熱と火花はコードで導く）", "order": 30, "required": true, "group": "演出と文字" },
    "smoke":  { "kind": "field", "type": "color", "label": "ドリフトの白煙", "order": 31, "required": true, "group": "演出と文字" },
    "finish": { "kind": "field", "type": "color", "label": "ゴール・縁石の白", "order": 32, "required": true, "group": "演出と文字" },
    "text":   { "kind": "field", "type": "color", "label": "HUD の文字", "order": 33, "required": true, "group": "演出と文字" }
  }
}
