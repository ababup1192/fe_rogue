{
  "//": "race.sfxtune.json の形の宣言（Studio の sections 方言）。音の中身（どんな波を重ねるか）は src/render/SfxRender.flix のデザインで、ここはそれに掛ける倍率だけを持つ。音 1 つ = セクション 1 つ（record）で、入れ子の record にはしない — 方言では record の fields に入れられるのは type を持つ欄だけ。つまみは WAV を描き出すときに効くので、保存したら make render-all して起動し直す（engine の高さの振れ幅だけは即反映）。",
  "version": 1,
  "sections": {
    "note": {
      "kind": "field",
      "type": "text",
      "label": "メモ",
      "order": 1,
      "widget": "multiline"
    },
    "enginePitchLow": {
      "kind": "field",
      "type": "float",
      "label": "止まっているときのエンジン音の高さ",
      "unit": "倍",
      "help": "ここと enginePitchHigh の 2 つだけ WAV を描き出し直さなくてよく、保存すると走行中のゲームへ即反映される。",
      "order": 2,
      "min": 0.3,
      "max": 2.0,
      "default": 0.7
    },
    "enginePitchHigh": {
      "kind": "field",
      "type": "float",
      "label": "最高速のときのエンジン音の高さ",
      "unit": "倍",
      "help": "止まっているときの高さより上にすると、速いほど唸りが高くなる。",
      "order": 3,
      "min": 0.5,
      "max": 3.0,
      "default": 1.9
    },
