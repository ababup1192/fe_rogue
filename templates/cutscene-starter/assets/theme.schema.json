{
  "//": "rpg.theme.json の形の宣言（Studio の sections 方言）。色 1 つ = kind field / type color のセクション 1 つ。幕の暗さ（表紙・クリア）も世界の空気なのでここに置く。派生色はコードで導く（独自の色を増やさない）。",
  "version": 1,
  "sections": {
    "sky":    { "kind": "field", "type": "color", "label": "夕暮れの空（背景）", "order": 1, "required": true },
    "path":   { "kind": "field", "type": "color", "label": "道",                 "order": 2, "required": true },
    "field":  { "kind": "field", "type": "color", "label": "畑",                 "order": 3, "required": true },
    "wall":   { "kind": "field", "type": "color", "label": "石垣",               "order": 4, "required": true },
    "fog":    { "kind": "field", "type": "color", "label": "霧",                 "order": 5, "required": true },
    "paper":  { "kind": "field", "type": "color", "label": "ふきだしの紙",       "order": 6, "required": true },
    "ink":    { "kind": "field", "type": "color", "label": "文字と輪郭",         "order": 7, "required": true },
    "accent": { "kind": "field", "type": "color", "label": "灯り（差し色）",     "order": 8, "required": true },
    "cloth":  { "kind": "field", "type": "color", "label": "住人の服",           "order": 9, "required": true },
    "titleVeil": {
      "kind": "field",
      "type": "float",
      "label": "表紙の幕の暗さ（0 = 素通し、1 = 真っ暗）",
      "order": 10,
      "min": 0,
      "max": 1,
      "default": 0.45
    },
    "clearVeil": {
      "kind": "field",
      "type": "float",
      "label": "クリア画面の幕の暗さ（0 = 素通し、1 = 真っ暗）",
      "order": 11,
      "min": 0,
      "max": 1,
      "default": 0.55
    }
  }
}
