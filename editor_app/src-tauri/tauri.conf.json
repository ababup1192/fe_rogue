{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flix GE Editor",
  "version": "0.1.0",
  "identifier": "com.flixge.editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/editor_server.jar": "editor_server.jar",
      "resources/jre": "jre",
      "resources/dist": "dist"
    }
  }
}
