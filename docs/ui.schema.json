{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui.schema.json",
  "title": "flix_game_engine ui.json document",
  "description": "UiDoc/UiSpec が読む UI 宣言ドキュメント。widget: box/text/sprite/poly/none + 図形 (circle/ngon/star/ellipse/sector/segment/line/polyline/bezier)。'//' で始まるキーはコメントとして無視される。",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "defaultFont": { "type": "string", "description": "font 未指定の text ノードが使うフォント名 (既定 \"ui\")" },
    "templates": {
      "type": "object",
      "description": "テンプレート名 → 部分ノード。ノード側の use で参照し、ノードの値が勝つ。",
      "additionalProperties": { "$ref": "#/$defs/nodePartial" }
    },
    "root": { "$ref": "#/$defs/node" }
  },
  "required": ["root"],
  "patternProperties": { "^//": {} },

  "$defs": {
    "vec2": {
      "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
    },
    "vec3": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
    },
    "points": {
      "type": "array", "items": { "$ref": "#/$defs/vec2" },
      "description": "頂点列 [[x,y], ...]。poly は rect 左上相対・3 点以上。line/polyline/bezier は rect 中心相対。"
    },
    "color": {
      "oneOf": [
        { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$", "description": "\"#rrggbb\"" },
        { "type": "object", "properties": { "hsv": { "$ref": "#/$defs/vec3" } },
          "required": ["hsv"], "additionalProperties": false,
          "description": "{\"hsv\":[h,s,v]} — h は 1 周 = 1.0" },
        { "type": "object", "properties": { "rgb": { "$ref": "#/$defs/vec3" } },
          "required": ["rgb"], "additionalProperties": false,
          "description": "{\"rgb\":[r,g,b]} — 各 0.0..1.0" }
      ]
    },
    "size": {
      "oneOf": [
        { "type": "number", "description": "固定 px" },
        { "type": "string", "enum": ["auto", "grow"] }
      ]
    },
    "widgetName": {
      "type": "string",
      "enum": ["none", "box", "text", "sprite", "poly",
               "circle", "ngon", "star", "ellipse", "sector", "segment",
               "line", "polyline", "bezier"]
    },
    "styleAndCommon": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "兄弟内で一意。'/' 不可。" },
        "use": { "type": "string", "description": "templates のテンプレ名。ノードの値が勝つ。" },
        "widget": { "$ref": "#/$defs/widgetName" },
        "visible": { "type": "boolean" },
        "bind": { "type": "string", "description": "text 流し込み先の bind key (UiStore 経路)" },
        "meta": { "type": "string" },
        "layer": { "type": "integer", "description": "root の描画レイヤ (UiStore 経路)" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },

        "dir": { "type": "string", "enum": ["row", "column"] },
        "gap": { "type": "number" },
        "pad": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
                 "description": "[left, top, right, bottom]" },
        "width": { "$ref": "#/$defs/size" },
        "height": { "$ref": "#/$defs/size" },
        "mainAlign": { "type": "string", "enum": ["start", "center", "end", "spaceBetween"] },
        "crossAlign": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "abs": { "$ref": "#/$defs/vec2", "description": "フロー外配置 (親コンテンツ原点相対)" },

        "color": { "$ref": "#/$defs/color" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "zIndex": { "type": "integer" },
        "cornerRadius": { "type": "number" },
        "borderWidth": { "type": "number" },
        "borderColor": { "$ref": "#/$defs/color" },

        "text": { "type": "string" },
        "font": { "type": "string" },
        "fontSize": { "type": "number" },
        "tint": { "$ref": "#/$defs/color" },

        "texture": { "type": "string" },
        "regionRect": {
          "type": "object",
          "properties": { "pos": { "$ref": "#/$defs/vec2" }, "size": { "$ref": "#/$defs/vec2" } },
          "required": ["pos", "size"]
        },
        "scale": { "$ref": "#/$defs/vec2" },
        "flipH": { "type": "boolean" },
        "flipV": { "type": "boolean" },
        "hframes": { "type": "integer" },
        "vframes": { "type": "integer" },
        "frame": { "type": "integer" },

        "points": { "$ref": "#/$defs/points" },
        "rotation": { "type": "number", "description": "1 周 = 1.0。pivot 未指定は rect 中心が原点。" },
        "pivot": { "$ref": "#/$defs/vec2" },

        "radius": { "type": "number" },
        "n": { "type": "integer", "minimum": 3 },
        "outer": { "type": "number" },
        "inner": { "type": "number" },
        "radii": { "$ref": "#/$defs/vec2", "description": "[rx, ry]" },
        "segments": { "type": "integer" },
        "from": { "type": "number", "description": "回転量 t (1 周 = 1.0)" },
        "to": { "type": "number" },
        "lineWidth": { "type": "number" },
        "steps": { "type": "integer" },
        "taper": {
          "type": "object",
          "properties": { "from": { "type": "number" }, "to": { "type": "number" } },
          "required": ["from", "to"],
          "description": "bezier の線形太さ: t=0 で from、t=1 で to"
        },
        "via": { "type": "string", "enum": ["render", "bezier"],
                 "description": "star/ellipse のレイヤ選択 (既定 render)" }
      },
      "patternProperties": { "^//": {} }
    },
    "widgetRequirements": {
      "allOf": [
        { "if": { "properties": { "widget": { "const": "box" } }, "required": ["widget"] },
          "then": { "required": ["color"] } },
        { "if": { "properties": { "widget": { "const": "sprite" } }, "required": ["widget"] },
          "then": { "required": ["texture"] } },
        { "if": { "properties": { "widget": { "const": "poly" } }, "required": ["widget"] },
          "then": { "required": ["points", "color"] } },
        { "if": { "properties": { "widget": { "const": "circle" } }, "required": ["widget"] },
          "then": { "required": ["radius", "color"] } },
        { "if": { "properties": { "widget": { "const": "ngon" } }, "required": ["widget"] },
          "then": { "required": ["n", "radius", "color"] } },
        { "if": { "properties": { "widget": { "const": "star" } }, "required": ["widget"] },
          "then": { "required": ["points", "outer", "inner", "color"] } },
        { "if": { "properties": { "widget": { "const": "ellipse" } }, "required": ["widget"] },
          "then": { "required": ["radii", "color"] } },
        { "if": { "properties": { "widget": { "const": "sector" } }, "required": ["widget"] },
          "then": { "required": ["radius", "from", "to", "color"] } },
        { "if": { "properties": { "widget": { "const": "segment" } }, "required": ["widget"] },
          "then": { "required": ["radius", "from", "to", "color"] } },
        { "if": { "properties": { "widget": { "const": "line" } }, "required": ["widget"] },
          "then": { "required": ["points", "lineWidth", "color"] } },
        { "if": { "properties": { "widget": { "const": "polyline" } }, "required": ["widget"] },
          "then": { "required": ["points", "lineWidth", "color"] } },
        { "if": { "properties": { "widget": { "const": "bezier" } }, "required": ["widget"] },
          "then": { "required": ["points", "taper", "color"] } }
      ]
    },
    "node": {
      "allOf": [
        { "$ref": "#/$defs/styleAndCommon" },
        { "$ref": "#/$defs/widgetRequirements" },
        { "anyOf": [ { "required": ["name"] }, { "required": ["use"] } ] }
      ]
    },
    "nodePartial": {
      "description": "テンプレート (部分ノード — name も widget も任意)",
      "$ref": "#/$defs/styleAndCommon"
    }
  }
}
