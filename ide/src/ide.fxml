<?xml version="1.0" encoding="UTF-8"?>
<!--
  flix_game_engine IDE のメインレイアウト。
  Phase 10c から「ワークスペース swap」方式: トップレベルの TabPane で Scenes mode と
  Resources mode を切り替える (Swing 版と同じ思想)。
    - Scenes tab: SplitPane(TreeView, canvas, Inspector)
    - Resources tab: SplitPane(Resource list 縦並び, sprite preview + save, property panel)
                     Phase 10c では中央/右は placeholder で骨組みのみ、内容は順次移植

  「見た目は FXML / 振る舞いは Flix」の分離方針。
  新しい widget を増やすときは原則: ここに <Node fx:id="..."> を追加 → 振る舞いは Flix。
-->
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1280" prefHeight="800"
            stylesheets="@ide.css">
    <top>
        <MenuBar fx:id="menuBar">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem fx:id="menuOpenProject" text="Open Project..."/>
                        <MenuItem fx:id="menuQuit" text="Quit"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <StackPane fx:id="centerStack">
        <TabPane fx:id="modeTabs" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- ────────── Scenes mode ────────── -->
                <Tab text="Scenes">
                    <content>
                        <SplitPane fx:id="scenesSplit" dividerPositions="0.18, 0.78">
                            <items>
                                <VBox>
                                    <children>
                                        <Label text="Scenes" styleClass="section-header"/>
                                        <TreeView fx:id="scenesTree" showRoot="false"
                                                  VBox.vgrow="ALWAYS"/>
                                        <Label text="シーンメモ" styleClass="section-header"/>
                                        <TextArea fx:id="sceneDescriptionArea"
                                                  prefRowCount="6"
                                                  wrapText="true"
                                                  promptText="このシーンの説明 (3〜5行)"
                                                  styleClass="scene-description"/>
                                    </children>
                                </VBox>
                                <StackPane fx:id="canvasContainer">
                                    <children>
                                        <ImageView fx:id="canvasView"
                                                   preserveRatio="false"
                                                   pickOnBounds="true"
                                                   scaleY="-1.0"
                                                   fitWidth="${canvasContainer.width}"
                                                   fitHeight="${canvasContainer.height}"/>
                                    </children>
                                </StackPane>
                                <VBox>
                                    <children>
                                        <Label text="Inspector" styleClass="section-header"/>
                                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                            <content>
                                                <VBox fx:id="inspectorContent" spacing="4"
                                                      styleClass="inspector-content"/>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <!-- ────────── Resources mode ────────── -->
                <Tab text="Resources">
                    <content>
                        <SplitPane fx:id="resourcesSplit" dividerPositions="0.20, 0.50">
                            <items>
                                <!-- 左: Resource list + Sub-entry list + Meta -->
                                <VBox>
                                    <children>
                                        <Label text="Resources" styleClass="section-header"/>
                                        <ListView fx:id="resourcesList" VBox.vgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_LEFT" spacing="4"
                                              styleClass="catalog-toolbar">
                                            <children>
                                                <Label text="Sub-entries" styleClass="section-header"
                                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                                <Button fx:id="subEntryAddBtn" text="+"
                                                        styleClass="catalog-btn"/>
                                                <Button fx:id="subEntryRemoveBtn" text="−"
                                                        styleClass="catalog-btn"/>
                                            </children>
                                        </HBox>
                                        <ListView fx:id="subEntriesList" VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                                <!-- 中央: Sprite preview + Save (Phase 10c では placeholder) -->
                                <VBox alignment="TOP_CENTER" spacing="8">
                                    <children>
                                        <Label text="Preview" styleClass="section-header"/>
                                        <!-- Preview のズームは canvas へのピンチで操作する
                                             (Maps タブの tileset と同じ操作感)。
                                             100% は IDE プレビュー上のネイティブ等倍
                                             (1 image px = 1 logical px) — texture アトラスの
                                             ピクセル自体を確認する用途。ゲーム実機での見え方は
                                             Sprite2D.scale / Camera2D.zoom / Viewport も絡むので
                                             この preview からは決まらない -->
                                        <HBox alignment="CENTER" spacing="4"
                                              styleClass="resource-zoom-bar">
                                            <children>
                                                <CheckBox fx:id="previewGridCheck" text="グリッド"/>
                                                <CheckBox fx:id="previewFrameAdjustCheck"
                                                          text="フレーム調整"/>
                                            </children>
                                        </HBox>
                                        <StackPane fx:id="resourcePreviewPane"
                                                   styleClass="resource-preview" VBox.vgrow="ALWAYS"/>
                                        <Label fx:id="resourceStatusLabel"
                                               styleClass="resource-status" text=""/>
                                    </children>
                                </VBox>
                                <!-- 右: Property panel (schema 駆動、JavaFXIdeUI が動的に組み立てる) -->
                                <VBox>
                                    <children>
                                        <Label text="Properties" styleClass="section-header"/>
                                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                            <content>
                                                <VBox fx:id="propertyPanel" spacing="4"
                                                      styleClass="property-panel"/>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <!-- ────────── Maps mode (中身は map-editor.fxml に分離、Flix 側で setContent) ────────── -->
                <Tab fx:id="mapsTab" text="Maps"/>
            </tabs>
        </TabPane>
        <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="10"
              styleClass="loading-overlay"
              maxWidth="360" maxHeight="80"
              visible="false" managed="false"
              StackPane.alignment="CENTER">
            <children>
                <Label fx:id="loadingLabel" text="Loading..." styleClass="loading-label"/>
                <ProgressBar fx:id="loadingBar" progress="0.0" prefWidth="320"/>
            </children>
        </VBox>
        </StackPane>
    </center>
    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="8">
            <children>
                <Label fx:id="statusScene" text="(no scene)" styleClass="status-cell"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="statusMouse" text="mouse: -" styleClass="status-cell"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="statusSelection" text="sel: -" styleClass="status-cell"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusFps" text="" styleClass="status-cell"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
