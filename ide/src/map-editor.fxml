<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maps タブの中身 (Level リスト + 中央 Canvas + 右に Layer リスト + パレット)。
  ide.fxml が <fx:include source="map-editor.fxml"/> ではなく別 FXMLLoader で
  ロードして mapsTab.setContent でマウントする。inner fx:id は専用 namespace
  経由でアクセスする (JavaFXIdeUI.flix)。

  Layer UI は Photoshop/Tiled 風の縦積みリスト。各行に
    [目玉トグル (👁)] [レイヤー名]
  を並べ、行クリックで選択 (現編集レイヤー)、目玉クリックで可視性 ON/OFF。
  描画順 (上→下) は Z 順そのまま: Entities が一番上、Floor が一番下。
-->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.canvas.Canvas?>

<SplitPane xmlns:fx="http://javafx.com/fxml" fx:id="mapsSplit"
           dividerPositions="0.18, 0.72">
    <items>
        <!-- 左: Level リスト (assets/maps/*.map.json) + 新規作成ボタン -->
        <VBox>
            <children>
                <Label text="Maps" styleClass="section-header"/>
                <ListView fx:id="mapsList" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="4" styleClass="map-list-toolbar">
                    <children>
                        <Button fx:id="mapNewBtn" text="+ New" prefWidth="80"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <!-- 中央: ツールバー + Canvas -->
        <VBox fx:id="mapEditorPane" alignment="TOP_CENTER" spacing="8">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="map-toolbar">
                    <children>
                        <Button fx:id="mapSaveBtn" text="保存"/>
                        <Label fx:id="mapDirtyLabel" text=""
                               styleClass="map-dirty-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Entity id:"/>
                        <TextField fx:id="mapEntityIdField" text="Door"
                                   prefColumnCount="10"/>
                    </children>
                </HBox>
                <Canvas fx:id="mapGridCanvas" width="400" height="400"/>
            </children>
        </VBox>
        <!-- 右: Layer リスト (上) + tile パレット (下) -->
        <VBox alignment="TOP_CENTER" spacing="4" styleClass="map-side-pane">
            <children>
                <Label text="Layers" styleClass="section-header"/>
                <VBox fx:id="mapLayerList" styleClass="layer-list">
                    <children>
                        <HBox fx:id="mapLayerRowEntities" styleClass="layer-row"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleEntities"
                                              text="&#x1F441;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameEntities" text="Entities"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                        <HBox fx:id="mapLayerRowWalls"
                              styleClass="layer-row,layer-row-selected"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleWalls"
                                              text="&#x1F441;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameWalls" text="Walls"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                        <HBox fx:id="mapLayerRowFloor" styleClass="layer-row"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleFloor"
                                              text="&#x1F441;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameFloor" text="Floor"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Separator/>
                <Label fx:id="mapPaletteLabel" text="Palette" styleClass="section-header"/>
                <Label fx:id="mapPaletteStatus" text="未選択"
                       styleClass="map-palette-status"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <Canvas fx:id="mapPaletteCanvas" width="320" height="224"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </items>
</SplitPane>
