<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maps タブの中身 (Level リスト + 中央 Canvas + tile パレット)。
  ide.fxml が <fx:include source="map-editor.fxml"/> ではなく別 FXMLLoader で
  ロードして mapsTab.setContent でマウントする。inner fx:id は専用 namespace
  経由でアクセスする (JavaFXIdeUI.flix)。
-->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.canvas.Canvas?>

<SplitPane xmlns:fx="http://javafx.com/fxml" fx:id="mapsSplit"
           dividerPositions="0.18, 0.72">
    <items>
        <!-- 左: Level リスト (assets/maps/*.map.json) -->
        <VBox>
            <children>
                <Label text="Maps" styleClass="section-header"/>
                <ListView fx:id="mapsList" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
        <!-- 中央: ツールバー + Layer radio + Canvas -->
        <VBox fx:id="mapEditorPane" alignment="TOP_CENTER" spacing="8">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="map-toolbar">
                    <children>
                        <Button fx:id="mapSaveBtn" text="保存"/>
                        <Label fx:id="mapDirtyLabel" text=""
                               styleClass="map-dirty-label"/>
                        <Label text="  Layer:"/>
                        <fx:define>
                            <ToggleGroup fx:id="mapLayerGroup"/>
                        </fx:define>
                        <RadioButton fx:id="mapLayerWallsRadio" text="Walls"
                                     toggleGroup="$mapLayerGroup" selected="true"/>
                        <RadioButton fx:id="mapLayerManualRadio" text="Manual"
                                     toggleGroup="$mapLayerGroup"/>
                    </children>
                </HBox>
                <Canvas fx:id="mapGridCanvas" width="400" height="400"/>
            </children>
        </VBox>
        <!-- 右: tile パレット (inca_tileset PNG, クリックで src 選択) -->
        <VBox alignment="TOP_CENTER" spacing="4" styleClass="map-palette-pane">
            <children>
                <Label text="Palette (Walls)" styleClass="section-header"/>
                <Label fx:id="mapPaletteStatus" text="未選択"
                       styleClass="map-palette-status"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <Canvas fx:id="mapPaletteCanvas" width="320" height="224"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </items>
</SplitPane>
