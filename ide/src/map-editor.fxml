<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maps タブの中身 (Level リスト + 中央 Canvas + 右に Layer リスト + Palette/Materials サブタブ)。
  ide.fxml が <fx:include source="map-editor.fxml"/> ではなく別 FXMLLoader で
  ロードして mapsTab.setContent でマウントする。inner fx:id は専用 namespace
  経由でアクセスする (JavaFXIdeUI.flix)。

  Layer UI は Photoshop/Tiled 風の縦積みリスト。各行に
    [目玉トグル (👁)] [レイヤー名]
  を並べ、行クリックで選択 (現編集レイヤー)、目玉クリックで可視性 ON/OFF。
  描画順 (上→下) は Z 順そのまま: Entities が一番上、Floor が一番下。

  右パネル下半分は TabPane で 2 つのサブタブを切替:
    - Palette : Floor / Walls 配置時のタイル選択 / Entities の identifier 入力
    - Materials : 現 Level の materialId に紐づく Material の wallMap を編集
-->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>

<SplitPane xmlns:fx="http://javafx.com/fxml" fx:id="mapsSplit"
           dividerPositions="0.18, 0.55">
    <items>
        <!-- 左: Level リスト (assets/maps/*.map.json) + 新規作成ボタン -->
        <VBox>
            <children>
                <Label text="Maps" styleClass="section-header"/>
                <ListView fx:id="mapsList" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="4" styleClass="map-list-toolbar">
                    <children>
                        <Button fx:id="mapNewBtn" text="+ New" prefWidth="80"/>
                        <Button fx:id="mapDeleteBtn" text="- Delete" prefWidth="80"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <!-- 中央: ツールバー + Canvas (自動保存なので保存ボタンは無し)。
             ピンチで拡大縮小、Ctrl+Z (macOS は Cmd+Z) で 1 操作 undo。
             Pencil / RangeSelect で操作モードを切り替える。 -->
        <VBox fx:id="mapEditorPane" alignment="TOP_CENTER" spacing="4">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="4"
                      styleClass="map-tool-bar">
                    <children>
                        <ToggleButton fx:id="mapToolPencilBtn"
                                       text="✎" selected="true"
                                       prefWidth="26" prefHeight="26"
                                       minWidth="26" minHeight="26"
                                       maxWidth="26" maxHeight="26"
                                       focusTraversable="false"
                                       styleClass="map-tool-btn"/>
                        <ToggleButton fx:id="mapToolRangeBtn"
                                       text="▭"
                                       prefWidth="26" prefHeight="26"
                                       minWidth="26" minHeight="26"
                                       maxWidth="26" maxHeight="26"
                                       focusTraversable="false"
                                       styleClass="map-tool-btn"/>
                    </children>
                </HBox>
                <ScrollPane fx:id="mapGridScroll" VBox.vgrow="ALWAYS">
                    <content>
                        <Canvas fx:id="mapGridCanvas" width="400" height="400"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
        <!-- 右: Layer リスト (上) + Palette/Materials サブタブ (下) -->
        <VBox alignment="TOP_CENTER" spacing="4" styleClass="map-side-pane">
            <children>
                <Label text="Layers" styleClass="section-header"/>
                <VBox fx:id="mapLayerList" styleClass="layer-list">
                    <children>
                        <HBox fx:id="mapLayerRowEntities" styleClass="layer-row"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleEntities"
                                              text="&#x1F440;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameEntities" text="Entities"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                        <HBox fx:id="mapLayerRowWalls" styleClass="layer-row"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleWalls"
                                              text="&#x1F440;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameWalls" text="Walls"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                        <HBox fx:id="mapLayerRowFloor"
                              styleClass="layer-row,layer-row-selected"
                              alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <ToggleButton fx:id="mapLayerVisibleFloor"
                                              text="&#x1F440;" selected="true"
                                              styleClass="layer-eye-btn"
                                              focusTraversable="false"/>
                                <Label fx:id="mapLayerNameFloor" text="Floor"
                                       styleClass="layer-name"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Separator/>
                <TabPane fx:id="mapRightTabs" VBox.vgrow="ALWAYS"
                         tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <!-- Palette タブ: Floor / Walls 用タイル選択 + Entities 用 id 入力 -->
                        <Tab fx:id="mapPaletteTab" text="Palette">
                            <content>
                                <VBox alignment="TOP_CENTER" spacing="4">
                                    <children>
                                        <!-- Floor / Walls 選択中に表示する Palette セクション -->
                                        <VBox fx:id="mapPaletteSection"
                                              alignment="TOP_CENTER" spacing="4"
                                              VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="mapPaletteLabel"
                                                       text="Palette"
                                                       styleClass="section-header"/>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT"
                                                      styleClass="palette-config-row">
                                                    <children>
                                                        <Label text="Sheet:"/>
                                                        <ComboBox fx:id="mapPaletteTextureCombo"
                                                                  maxWidth="Infinity"
                                                                  HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT"
                                                      styleClass="palette-config-row">
                                                    <children>
                                                        <Label text="Cell:"/>
                                                        <Spinner fx:id="mapPaletteCellWSpinner"
                                                                 prefWidth="68"
                                                                 editable="true"/>
                                                        <Label text="×"/>
                                                        <Spinner fx:id="mapPaletteCellHSpinner"
                                                                 prefWidth="68"
                                                                 editable="true"/>
                                                        <Label text="px"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT"
                                                      styleClass="palette-config-row">
                                                    <children>
                                                        <Label text="Margin:"/>
                                                        <Spinner fx:id="mapPaletteMarginXSpinner"
                                                                 prefWidth="68"
                                                                 editable="true"/>
                                                        <Label text="×"/>
                                                        <Spinner fx:id="mapPaletteMarginYSpinner"
                                                                 prefWidth="68"
                                                                 editable="true"/>
                                                        <Label text="px"/>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="mapPaletteStatus"
                                                       text="未選択"
                                                       styleClass="map-palette-status"/>
                                                <ScrollPane fx:id="mapPaletteScroll"
                                                            fitToWidth="false"
                                                            VBox.vgrow="ALWAYS">
                                                    <content>
                                                        <Canvas fx:id="mapPaletteCanvas"
                                                                width="480" height="336"/>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                        <!-- Entities 選択中の Entity Id 入力セクション -->
                                        <VBox fx:id="mapEntitySection"
                                              alignment="TOP_CENTER" spacing="4"
                                              visible="false" managed="false"
                                              VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label text="Entity"
                                                       styleClass="section-header"/>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT"
                                                      styleClass="palette-config-row">
                                                    <children>
                                                        <Label text="id:"/>
                                                        <TextField fx:id="mapEntityIdField"
                                                                   text="Door"
                                                                   maxWidth="Infinity"
                                                                   HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <Label text="グリッドをクリックで配置 / 右クリックで削除"
                                                       styleClass="map-palette-status"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                        <!-- Materials タブ: 現 Level の materialId に紐づく wallMap を編集 -->
                        <Tab fx:id="mapMaterialsTab" text="auto-layer">
                            <content>
                                <VBox alignment="TOP_CENTER" spacing="6"
                                      styleClass="auto-layer-tab-content">
                                    <padding>
                                        <Insets top="8" right="8" bottom="8" left="8"/>
                                    </padding>
                                    <children>
                                        <VBox fx:id="mapMaterialsWallMapBox"
                                              spacing="3" alignment="TOP_LEFT"/>
                                        <Separator/>
                                        <Label text="Rules" styleClass="section-header"/>
                                        <HBox spacing="4" alignment="CENTER_LEFT">
                                            <children>
                                                <Button fx:id="mapRuleAddBtn"
                                                        text="+ Add"/>
                                                <Button fx:id="mapRuleRemoveBtn"
                                                        text="- Remove"/>
                                            </children>
                                        </HBox>
                                        <ListView fx:id="mapRuleList" prefHeight="100"/>
                                        <VBox fx:id="mapRuleEditor"
                                              visible="false" managed="false"
                                              spacing="4">
                                            <children>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Name:"/>
                                                        <TextField fx:id="mapRuleNameField"
                                                                   maxWidth="Infinity"
                                                                   HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <Label text="Pattern (3×3): クリックで 任意→空→床→壁"
                                                       styleClass="map-palette-status"/>
                                                <GridPane fx:id="mapRulePatternGrid"
                                                          hgap="2" vgap="2"
                                                          alignment="CENTER_LEFT"/>
                                                <Label fx:id="mapRuleTileLabel"
                                                       text="Tile: 未設定 (tileset をクリックで指定)"
                                                       styleClass="map-palette-status"/>
                                                <HBox spacing="4"
                                                      alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Chance:"/>
                                                        <Spinner fx:id="mapRuleChanceSpinner"
                                                                 prefWidth="80"
                                                                 editable="true"/>
                                                        <Label text="\%"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <Label fx:id="mapMaterialsStatus"
                                               text="セル未選択"
                                               styleClass="map-palette-status"/>
                                        <ScrollPane fx:id="mapMaterialsTilesetScroll"
                                                    fitToWidth="false"
                                                    VBox.vgrow="ALWAYS">
                                            <content>
                                                <Canvas fx:id="mapMaterialsTilesetCanvas"
                                                        width="480" height="336"/>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </items>
</SplitPane>
