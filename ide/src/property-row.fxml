<?xml version="1.0" encoding="UTF-8"?>
<!--
  Inspector / Property panel で使う共通レイアウト「key Label + 値 widget」。
  Flix の addPropertyRow がこの FXML を loadRowTemplate で読み込み、keyLabel に文字列、
  valueSlot に widget を流し込む。レイアウト/余白/フォント/key 幅は CSS と FXML 属性で
  完結させ、Flix 側はデータ注入だけにする
-->
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>

<HBox xmlns:fx="http://javafx.com/fxml"
      styleClass="property-row"
      alignment="CENTER_LEFT"
      spacing="6">
    <children>
        <Label fx:id="keyLabel" styleClass="property-key" minWidth="120"/>
        <StackPane fx:id="valueSlot" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
    </children>
</HBox>
