// Level — テキストグリッドで地形と敵を宣言する読み込み専用レイヤー（mod Level）。
//
// 16px セル・208 列 × 30 行（3328×480px = 横 10.4 画面 × 縦 2 画面）。グリフ語彙は 7 種:
//   '#' 硬い床  '-' 一方通行  'P' 出発点  'w' 歩く敵  'f' パタパタ  's' トゲ  '.' 空
// 各行を横方向に platRun-length 融合し、同じグリフが連続するセルを 1 枚の矩形にまとめる
// （セルごとに矩形を作ると当たり判定が無駄に増える）。縦方向の融合はしない: 地面は
// 4 行分＝上下 4 枚の矩形になるが、プレイヤーが触れるのは常にどれかの上面か側面なので
// 継ぎ目があっても手触りに影響しない。
// 坂（slopePlatforms・id 500 番台）はグリフに乗らない別枠: 丘の区間に手動で配置する。
// id 帯: 硬い床 200番台・一方通行 300番台・坂 500番台・敵 600番台（行優先の走査順で採番）。
//
// レベルの文法はマリオ 1-1 に倣う（上が広くて開放的・障害物は疎・左から右へ難度が上がる）。
// 設計原理は「疾走感」: レベル全体を止まらずに 1 本のダッシュで走破できる。敵・段差・動く床は
// 足を止める障害でなく滑走路の一部 — 踏みバウンド（vy=-320）は小ジャンプを兼ね、
// 敵の間隔は走りのリズムで次の障害を越えられる位置に置く（敵 = トランポリン）。
//   1. 列 0-30    長い平坦な助走路。出発点 P だけ（P スピードを 280 まで作る場所）。
//   2. 列 30-55   低い段差（跳ぶきっかけ）→ 歩く敵（踏むと穴 1 を丸ごと越えるトランポリン）→
//                 一方通行の棚 + その先の歩く敵（棚から降り踏みで丘へ跳ね上がる）。棚の塔は 3 段。
//   3. 列 55-85   丘: 緩い坂 → 台地 → 45° 坂 → 高台 → 緩い下り（下りで加速が伸びる）。上空にパタパタ。
//   4. 列 85-115  浮き床の連続ジャンプ（下は地面 = 落ちても死なない練習）。地上にトゲ・
//                 抜けた先に中間地点の旗（列 105）。
//   5. 列 115-145 長い助走路 → P スピードゲートの大穴（8 マス = 128px・素の走りでは届かない）。
//                 上空に一方通行のボーナス床（浮き床の高いルートでも渡れる）。
//   6. 列 145-175 敵の織り込み: パタパタ 2 体（bob の高さ違い）+ 歩く敵 2 体。
//                 歩く敵 2 体は 112px 間隔 = ダッシュ踏みバウンドの 2 連鎖（踏み→踏み→穴越え）。
//   7. 列 175-205 フィナーレ: 大きめの穴（96px・フェリーが phase 調整済みで橋になる）→
//                 上りの階段（2 マス刻み × 5 段）→ 頂上から飛び降りてゴールの旗（列 204）へ。
// 高所（行 13-16）の一方通行の棚は義務でない開放感 + 高ルート。カメラは縦にも追従する。

mod Level {

    // ── 寸法 ──

    pub def levelWidth(): Float64 = 3328.0
    pub def levelHeight(): Float64 = 480.0

    /// ゴールの旗の x（列 204 の中心）。プレイヤーがここを越えたらクリア。
    pub def goalX(): Float64 = 3272.0

    /// 中間地点の旗の x（列 105 の中心・セクション 4 の出口）。越えるとリスポーンがここになる。
    pub def checkpointX(): Float64 = 1688.0

    /// 中間地点のリスポーン位置: 旗の x・地面のすぐ上の空中（出発点 P と同じ流儀で落ちて立つ）。
    pub def checkpointPos(): Vec2.Vec2 = { x = checkpointX(), y = 392.0 }

    // ── グリッド定義（208 列 × 30 行） ──
    // 地面は行 26-29（上面 y=416）。穴は 3 本: 列 43-44（32px・踏みバウンドで丸ごと越える）/
    // 列 144-151（128px・P スピードゲート）/ 列 176-181（96px・フェリーが橋・階段の手前）。
    def rows(): List[String] =
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................................" ::
        "................................................................................................................................................................................................-----..........." ::
        "...............................................----............................................................................................................................................................." ::
        "................................................................................................................................................................................................................" ::
        ".......................................................................................................................................---------------------..................................##................" ::
        ".................................................................f.............................................................###............................................................##................" ::
        "............................................----............................................................................................................................................####................" ::
        "......................................................................................###......###.....###.....###.....###.........................................f........................####................" ::
        "..........................................................................................................................................................................................######................" ::
        ".............................................................................................................................................................f........-------.............######................" ::
        "...............................................----.............####....................................................................................................................########................" ::
        "................................................................####....................................................................................................................########................" ::
        "...P........................................................############..............................................................................................................##########................" ::
        ".................................##.....w...........w.......############............................s......................................................w.......w..................##########................" ::
        "###########################################..###################################################################################################........########################......##########################" ::
        "###########################################..###################################################################################################........########################......##########################" ::
        "###########################################..###################################################################################################........########################......##########################" ::
        "###########################################..###################################################################################################........########################......##########################" ::
        Nil

    // ── パーサ（純粋） ──

    /// 全セルを行優先（行 → 列の順）で (col, row, glyph) に展開する。
    pub def cellsOf(rowsList: List[String]): List[(Int32, Int32, Char)] =
        rowsList
        |> List.zipWithIndex
        |> List.flatMap(match (row, chars) ->
            chars
            |> String.toList
            |> List.zipWithIndex
            |> List.map(match (col, ch) -> (col, row, ch)))

    /// 走査中の状態: 直前まで見ていたグリフ連続区間（開始列・現在の長さ）と、
    /// これまでに確定した platRun の列（列の昇順で先頭に積む→最後に反転）。
    type alias RunScan = { current = Option[(Int32, Int32)], finished = List[(Int32, Int32)] }

    /// 1 セル分進める。狙ったグリフが続けば current を伸ばし、途切れたら finished へ確定する。
    def stepRunScan(glyph: Char, scan: RunScan, colCh: (Int32, Char)): RunScan =
        let (col, ch) = colCh;
        match (ch == glyph, scan#current) {
            case (true,  Some((startCol, len))) => { current = Some((startCol, len + 1)) | scan }
            case (true,  None)                  => { current = Some((col, 1)) | scan }
            case (false, Some(platRun))         => { current = None, finished = platRun :: scan#finished }
            case (false, None)                  => scan
        }

    /// 走査を締める: 行末で継続中の platRun があれば確定させる。
    def closeRunScan(scan: RunScan): List[(Int32, Int32)] =
        let closed = match scan#current {
            case Some(platRun) => platRun :: scan#finished
            case None      => scan#finished
        };
        List.reverse(closed)

    /// 1 行分のセル列から、指定グリフの水平ラン（連続区間）を [(startCol, len)] で拾う。
    /// 行優先の走査順を保つため、列の昇順で 1 パス走査する。
    def runsInRow(glyph: Char, rowStr: String): List[(Int32, Int32)] =
        let initScan = { current = None, finished = Nil };
        rowStr
        |> String.toList
        |> List.zipWithIndex
        |> List.foldLeft(stepRunScan(glyph), initScan)
        |> closeRunScan

    /// 全行にわたる指定グリフの水平ラン一覧（行優先・行の中は列の昇順）。
    def allRuns(glyph: Char): List[(Int32, Int32, Int32)] =
        rows()
        |> List.zipWithIndex
        |> List.flatMap(match (row, rowStr) ->
            runsInRow(glyph, rowStr) |> List.map(match (col, len) -> (row, col, len)))

    def cellSize(): Float64 = 16.0

    /// (row, col, len) の水平ランを Platform 1 枚に変換する。高さは常に 1 セル分。
    def runToPlatform(id: EntityId, oneWay: Bool, platRun: (Int32, Int32, Int32)): Field.Platform =
        let (row, col, len) = platRun;
        let w = Int32.toFloat64(len) * cellSize();
        let cx = Int32.toFloat64(col) * cellSize() + w / 2.0;
        let cy = Int32.toFloat64(row) * cellSize() + cellSize() / 2.0;
        let pos = { x = cx, y = cy };
        let size = { x = w, y = cellSize() };
        if (oneWay) Field.oneWayAt(id, pos, size) else Field.rigid(id, pos, size)

    def assignIds(baseId: EntityId, runs: List[(Int32, Int32, Int32)]): List[(EntityId, (Int32, Int32, Int32))] =
        runs |> List.zipWithIndex |> List.map(match (i, platRun) -> (baseId + i, platRun))

    /// 硬い床（'#'）の platRun 融合結果。id は 200 から行優先の platRun 順に採番。
    pub def solidRuns(): List[Field.Platform] =
        allRuns('#')
        |> assignIds(200)
        |> List.map(match (id, platRun) -> runToPlatform(id, false, platRun))

    /// 一方通行（'-'）の platRun 融合結果。id は 300 から行優先の platRun 順に採番。
    pub def oneWayRuns(): List[Field.Platform] =
        allRuns('-')
        |> assignIds(300)
        |> List.map(match (id, platRun) -> runToPlatform(id, true, platRun))

    /// グリッド由来の地形（硬い床のあとに一方通行）。坂は含まない。
    pub def gridPlatforms(): List[Field.Platform] =
        List.append(solidRuns(), oneWayRuns())

    // ── 出発点 ──

    /// 'P' セルの中心座標（行優先で最初に見つかったもの）。無ければ (60.0, 100.0) にフォールバック。
    pub def spawnOf(): Vec2.Vec2 =
        cellsOf(rows())
        |> List.filter(match (_, _, ch) -> ch == 'P')
        |> List.head
        |> Option.map(match (col, row, _) ->
            { x = Int32.toFloat64(col) * cellSize() + cellSize() / 2.0,
              y = Int32.toFloat64(row) * cellSize() + cellSize() / 2.0 })
        |> Option.getWithDefault({ x = 60.0, y = 100.0 })

    // ── 敵（グリフから抽出・id 600 番台を行優先で採番） ──
    // 既定の動き: 歩く敵 = 横 ±24px・周期 4 秒 / パタパタ = 縦 ±32px・周期 2 秒 / トゲ = 固定。
    // 足の置き方: 歩く敵とトゲは足元をセルの下端（= 真下の床の上面）に揃えて立たせ、
    // パタパタは空中なのでセル中心を基準にする。

    def walkerRange(): Float64 = 24.0
    def walkerPeriod(): Float64 = 4.0
    def flyerRange(): Float64 = 32.0
    def flyerPeriod(): Float64 = 2.0

    /// 歩く敵の位相（列ごとの調整表・既定 0.0）。セクション 6 の 2 体（列 155・163）は
    /// レベル走破の台本が踏みバウンド 2 連鎖で通過する時刻に頭が真下に来るよう合わせた実測値。
    /// パタパタの位相（列ごとの調整表・既定 0.0）。列 157 はレベル走破の踏み 2 連鎖が
    /// 真横を通る時刻に高い位置へ退くよう合わせた実測値。
    def flyerPhaseAt(col: Int32): Float64 =
        if (col == 157) 0.35
        else 0.0

    def walkerPhaseAt(col: Int32): Float64 =
        if (col == 155) 0.264
        else if (col == 163) 0.104
        else 0.0

    /// 敵グリフ 1 個を Enemy へ（id は行優先の通し番号）。
    def cellToEnemy(id: EntityId, cell: (Int32, Int32, Char)): Option[Field.Enemy] =
        let (col, row, ch) = cell;
        let cx = Int32.toFloat64(col) * cellSize() + cellSize() / 2.0;
        let standY = Int32.toFloat64(row + 1) * cellSize() - Field.enemyRadius();
        let centerY = Int32.toFloat64(row) * cellSize() + cellSize() / 2.0;
        if (ch == 'w') Some(Field.walkerAtPhase(id, { x = cx, y = standY }, walkerRange(), walkerPeriod(), walkerPhaseAt(col)))
        else if (ch == 'f') Some(Field.flyerAtPhase(id, { x = cx, y = centerY }, flyerRange(), flyerPeriod(), flyerPhaseAt(col)))
        else if (ch == 's') Some(Field.spikyAt(id, { x = cx, y = standY }))
        else None

    /// レベルの敵一覧（行優先・id 600 から）。
    pub def enemies(): List[Field.Enemy] =
        cellsOf(rows())
        |> List.filter(match (_, _, ch) -> ch == 'w' or ch == 'f' or ch == 's')
        |> List.zipWithIndex
        |> List.filterMap(match (i, cell) -> cellToEnemy(600 + i, cell))

    // ── 坂（グリッドの外・丘の区間に手動配置・id 500 番台） ──
    // 丘の断面: 地面(416) → 緩い坂 500 → 台地(384) → 45° 坂 501 → 高台(352) → 緩い下り 502 →
    // 台地(384) → 段差で地面へ。台地・高台の平らな部分はグリッドの '#'（行 22-25）が受ける。

    /// 緩い上り坂（底辺 64・高さ 32 ≈ 26.6°）。地面から台地へ。x 896..960 / y 384..416。
    pub def slopeUpGentle(): Field.Platform =
        Field.slopeAt(500, { x = 928.0, y = 400.0 }, { x = 64.0, y = 32.0 }, true)

    /// 45° の上り坂（32×32）。台地から高台へ。x 992..1024 / y 352..384。
    pub def slopeUpSteep(): Field.Platform =
        Field.slopeAt(501, { x = 1008.0, y = 368.0 }, { x = 32.0, y = 32.0 }, true)

    /// 緩い下り坂（底辺 64・高さ 32）。高台から台地へ。x 1088..1152 / y 352..384。
    pub def slopeDownGentle(): Field.Platform =
        Field.slopeAt(502, { x = 1120.0, y = 368.0 }, { x = 64.0, y = 32.0 }, false)

    pub def slopePlatforms(): List[Field.Platform] =
        slopeUpGentle() :: slopeUpSteep() :: slopeDownGentle() :: Nil

    // ── 動く床（グリッドの外・id 400 番台） ──
    // フィナーレの穴（列 176-181・x 2816..2912・96px）を横断するフェリー。デッキの上面は
    // 地面の上面（416）と同じ高さ = 走りの続きとして踏める橋。
    // 振れ幅 24px で穴の左端と右端をちょうど往復する（デッキ幅 48 + 振れ 48 = 穴 96）。
    // phase は疾走感の要: レベル走破の台本（Trace.levelRunCues）が踏み 2 連鎖から走り込む
    // 時刻に、デッキが穴の左半分に居て「待たずに乗れる」よう合わせた実測値。
    // トンネリング境界（速さ 64px/秒 以下）: 4 × 24 / 2.0 = 48 px/秒 ✓

    /// フェリーの phase（0..1・triWave の位相）。levelRunCues の実測で調整した値。
    pub def ferryPhase(): Float64 = 0.32

    /// フィナーレの穴のフェリー（id 400）。
    pub def ferryPlatform(): Field.Platform =
        Field.movingAt(400,
            { x = 2864.0, y = 423.0 }, { x = 48.0, y = 14.0 },
            { axis = { x = 1.0, y = 0.0 }, amplitude = 24.0, period = 2.0, phase = ferryPhase() })

    pub def movingPlatforms(): List[Field.Platform] =
        ferryPlatform() :: Nil

    // ── 見えない境界壁（レベルの外・落下防止） ──
    // グリッドの端の柱を絵にすると圧迫感が出るので、レベル範囲 [0,3328] の外に置く:
    // カメラのクランプは [0,3328] を映すだけなので、この壁は画面に決して入らない。
    // id は硬い床帯（200〜）の手前の 198/199 を使う。高さはレベル全高をカバーする。

    pub def boundaryWalls(): List[Field.Platform] =
        Field.rigid(198, { x = -8.0, y = 240.0 }, { x = 16.0, y = 960.0 }) ::
        Field.rigid(199, { x = 3336.0, y = 240.0 }, { x = 16.0, y = 960.0 }) :: Nil

    // ── 全地形 ──

    pub def allPlatforms(): List[Field.Platform] =
        List.append(boundaryWalls(),
            List.append(gridPlatforms(), List.append(slopePlatforms(), movingPlatforms())))
}
