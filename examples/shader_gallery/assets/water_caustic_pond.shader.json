      "of": { "kind": "smoothstep", "lo": 0.0, "hi": 0.08,
        "of": { "kind": "warp", "amount": 0.05, "scale": 3.0, "seed": 11,
          "of": { "kind": "scaled", "factor": 4.0, "scroll": { "x": 0.015, "y": 0.01 },
            "of": { "kind": "worley", "scale": 1.0, "seed": 7, "out": "f2mf1" } } } }
