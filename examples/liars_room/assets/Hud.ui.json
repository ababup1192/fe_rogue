{
  "defaultFont": "default",
  "paletteFile": "assets/palette.json",
  "root": {
    "name": "Hud", "widget": "none", "visible": false, "layer": 1,
    "children": [
      { "name": "bar", "widget": "box", "color": "@panelDark", "alpha": 0.85, "zIndex": 100,
        "abs": [0, 0], "width": 320, "height": 16,
        "dir": "row", "pad": [8, 3, 8, 3], "gap": 18, "crossAlign": "center",
        "children": [
          { "name": "stage", "widget": "text", "text": "ステージ 1／10", "bind": "stageLabel",
            "wrap": "auto", "fontSize": 10, "tint": "@accent", "zIndex": 110 },
          { "name": "liars", "widget": "text", "text": "うそつき 1にん", "bind": "liarsLabel",
            "wrap": "auto", "fontSize": 10, "tint": "#d95763", "zIndex": 110 },
          { "name": "keys", "widget": "text", "text": "Z:はなす C:メモ H:ヒント",
            "fontSize": 10, "tint": "@muted", "zIndex": 110,
            "lint-ui": "対象外 — キー割り当ての固定短文で、実行時に文言が変わらない" }
        ]
      }
    ]
  }
}
