          { "name": "floorName", "widget": "text", "bind": "floorName", "font": "ui", "fontSize": 2.6, "tint": "#8c99ad", "zIndex": 3 }
        ]
      },

      { "name": "phaseRow", "widget": "none", "abs": [0, 0], "width": 240, "height": 7.5,
