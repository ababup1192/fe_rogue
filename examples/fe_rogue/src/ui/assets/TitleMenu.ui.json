{
  "defaultFont": "ui",
  "templates": {
    "option": { "widget": "none", "height": 16, "dir": "column", "mainAlign": "center", "crossAlign": "center", "pad": [1.5, 0, 1.5, 0] },
    "label": { "widget": "text", "fontSize": 8.0, "tint": "#b2b2bf", "zIndex": 2 }
  },
  "root": {
    "name": "TitleMenu", "widget": "none", "visible": false, "layer": 6,
    "children": [
      { "name": "bg", "widget": "box", "abs": [0, 0], "width": 240, "height": 128,
        "color": "#0f121c", "alpha": 1.0, "zIndex": 0 },

      { "name": "titleRow", "widget": "none", "abs": [0, 30], "width": 240,
        "dir": "row", "mainAlign": "center",
        "children": [
          { "name": "title", "widget": "text", "text": "遺宝探索記", "fontSize": 14.0, "tint": "#ffffff", "zIndex": 1 }
        ]
      },

      { "name": "menu", "widget": "none", "abs": [75, 62], "width": 90,
        "dir": "column", "gap": 0.0, "crossAlign": "stretch",
        "children": [
          { "name": "highlight", "widget": "box", "color": "#16314f", "alpha": 1.0,
            "borderWidth": 0.5, "borderColor": "#2f6df0", "cornerRadius": 2, "zIndex": 1,
            "abs": [0.5, 0.5], "width": 89, "height": 15 },
          { "use": "option", "name": "item0", "meta": "newGame",
            "children": [ { "use": "label", "name": "label", "text": "はじめから" } ] },
          { "use": "option", "name": "item1", "meta": "resume",
            "children": [ { "use": "label", "name": "label", "text": "中断から再開" } ] }
        ]
      }
    ]
  }
}
