{
  "description": "フェーズ別に追従先を切り替えるトップレベル Camera2D\nCursor/選択中の味方/動作中の敵 を smoothing 付きで追う",
  "dragBottomMargin": 0.3,
  "dragHorizontalEnabled": true,
  "dragLeftMargin": 0.3,
  "dragRightMargin": 0.3,
  "dragTopMargin": 0.3,
  "dragVerticalEnabled": true,
  "limitBottom": 999999,
  "limitLeft": -999999,
  "limitRight": 999999,
  "limitTop": -999999,
  "name": "Camera",
  "pos": [
    0,
    0
  ],
  "positionSmoothingEnabled": true,
  "positionSmoothingSpeed": 5,
  "type": "Camera2D",
  "zoom": [0.4, 0.4],
  "processCallback": "IdleProcess",
  "rotationSmoothingSpeed": 5,
  "scale": [1, 1]
}
